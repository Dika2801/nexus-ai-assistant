# =============================================================================
# NEXUS AI Assistant — Environment Variables
# OpenAI adalah SATU-SATUNYA AI provider. Google/Gemini TIDAK digunakan.
# JANGAN pernah menaruh nilai asli di file ini — ini hanya template contoh.
# Saat deploy, isi lewat Secrets (Hugging Face Spaces / GitHub Actions secret /
# environment variable server), BUKAN dengan mengedit file ini langsung.
# =============================================================================

# --- WAJIB ---
# OPENAI_API_KEY: API key OpenAI kamu. Hanya dibaca di backend (server.ts),
# TIDAK PERNAH dikirim ke frontend/browser.
OPENAI_API_KEY=""

# --- KONFIGURASI MODEL (OPSIONAL) ---
# Nama model bisa diganti tanpa mengubah kode. Default aman & tersedia luas
# di kebanyakan akun OpenAI. Jika akun kamu punya akses ke model lain
# (mis. "gpt-5.6" bila sudah tersedia), cukup ganti nilainya di sini.
OPENAI_CHAT_MODEL="gpt-4o"
OPENAI_CHAT_MODEL_MINI="gpt-4o-mini"
OPENAI_REASONING_MODEL="o3-mini"
OPENAI_IMAGE_MODEL="dall-e-3"
OPENAI_IMAGE_EDIT_MODEL="gpt-image-1"
OPENAI_TTS_MODEL="tts-1"
OPENAI_TRANSCRIBE_MODEL="whisper-1"

# --- FITUR FACE SWAP (OPSIONAL) ---
# URL microservice Python terpisah (folder /faceswap-service) yang menjalankan
# InsightFace + GFPGAN. Kosongkan jika fitur Face Swap belum ingin diaktifkan
# — endpoint akan mengembalikan pesan "belum dikonfigurasi", bukan fitur palsu.
FACE_SWAP_SERVICE_URL=""

# --- DATABASE (OPSIONAL) ---
SUPABASE_URL=""
SUPABASE_ANON_KEY=""

# --- ADMIN (OPSIONAL) ---
# Default 'admin123' jika dikosongkan — SANGAT disarankan diisi sebelum production.
ADMIN_PASSWORD=""

# --- APP URL (OPSIONAL) ---
# URL tempat aplikasi ini di-hosting (untuk link self-referential/OAuth callback).
APP_URL=""
